# Sakshi-Protocol — API keys
# Copy this file to `.env` and fill in your own keys.
# The .env file is gitignored and must never be committed.

# Required: OpenAI is used for embeddings (semantic-similarity signal) on every
# prompt, and for reasoning-consistency checks on reasoning-type prompts.
OPENAI_API_KEY=your-openai-key-here

# Required for the model you run with --model:
#   claude-sonnet-4-6  -> ANTHROPIC_API_KEY
#   llama-3.3-70b / qwen-3.5-9b (via Together) -> TOGETHER_API_KEY
ANTHROPIC_API_KEY=your-anthropic-key-here
TOGETHER_API_KEY=your-together-key-here
